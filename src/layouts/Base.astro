---
import '../styles/global.css';

const {
  title = 'YOKÓ — Coffee & Matcha',
  description = 'YOKÓ Coffee & Matcha: café artesanal, matcha, brunch y repostería en un espacio acogedor donde cada taza invita a disfrutar de un momento de paz.'
} = Astro.props;

const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const imagenOG = new URL('/og.jpg', Astro.site).href;

const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Menú', href: '/menu' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' }
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Favicon YOKÓ -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="YOKÓ" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YOKÓ Coffee & Matcha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={imagenOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="YOKÓ, ir a Inicio">
          YOKÓ <small>COFFEE & MATCHA</small>
        </a>

        <details class="mobile-nav">
          <summary>Menú <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Navegación móvil">
            {links.map(link =>
              <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            )}
          </nav>
        </details>

        <nav class="desktop-nav" aria-label="Navegación principal">
          {links.map(link =>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          )}
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="brand">
          YOKÓ <small>COFFEE & MATCHA</small>
        </div>
        <nav aria-label="Navegación del pie">
          {links.map(link => <a href={link.href}>{link.label}</a>)}
        </nav>
        <span>Un momento de paz en cada taza.</span>
      </div>
    </footer>
  </body>
</html>