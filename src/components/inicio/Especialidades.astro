
---
import { Image } from 'astro:assets';

const especialidades = [
  {
    nombre: 'Café',
    descripcion: 'Café artesanal para disfrutar en cada momento.',
    imagen: 'iced-latte.jpg',
    alt: 'Café frío con leche y hielo'
  },
  {
    nombre: 'Matcha',
    descripcion: 'Bebidas a base de matcha para disfrutar con calma.',
    imagen: 'matcha-latte.jpg',
    alt: 'Taza de matcha latte'
  },
  {
    nombre: 'Brunch',
    descripcion: 'Desayunos y comidas ligeras para compartir.',
    imagen: 'avocado-toast.jpg',
    alt: 'Tostada con aguacate y tomates'
  },
  {
    nombre: 'Repostería',
    descripcion: 'Opciones dulces para acompañar tu bebida favorita.',
    imagen: 'croissant.jpg',
    alt: 'Croissant dorado en un plato'
  }
];
---

<section class="section" id="nuestras-especialidades">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">YOKÓ</p>
        <h2>Nuestras especialidades</h2>
      </div>

      <a class="text-link" href="/menu">
        Explora nuestra carta ↗
      </a>
    </div>

    <div class="specialties">
      {especialidades.map((item) => (
        <article class="specialty-card">
          <div class="specialty-image">
            <Image
              src={'/imagenes/' + item.imagen}
              alt={item.alt}
              width={326}
              height={300}
              loading="lazy"
            />
          </div>
          <h3>{item.nombre}</h3>
          <p class="specialty-description">
            {item.descripcion}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
