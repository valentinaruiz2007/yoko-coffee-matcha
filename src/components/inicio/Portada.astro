
---
import { Image } from 'astro:assets';
---

<section class="hero" id="portada">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">YOKÓ · COFFEE & MATCHA</p>

      <h1>Un momento de paz en cada taza.</h1>

      <p class="intro">
        Disfruta del café, matcha y momentos especiales en YOKÓ.
      </p>

      <a href="/menu" class="btn btn-dark">
        Nuestra carta <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="hero-art">
      <Image
        src="/imagenes/foto-06.jpeg"
        alt="Café con arte latte junto a un vaso de matcha"
        width={1280}
        height={853}
        loading="eager"
      />

      <div class="art-label">CAFÉ & MATCHA</div>
    </div>
  </div>
</section>
